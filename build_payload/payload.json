{"app_name":"MyWebApp","package_id":"com.app.mywebapp","splash_color":"#1E1E1E","icon_base64":"","html_content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>MyWebApp<\/title>\n  <style>\nbody {\n  margin: 0;\n  padding: 20px;\n  font-family: system-ui, -apple-system, sans-serif;\n  background: #121214;\n  color: #ffffff;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 90vh;\n}\n.card {\n  background: #1e1e24;\n  padding: 24px;\n  border-radius: 12px;\n  box-shadow: 0 4px 20px rgba(0,0,0,0.5);\n  text-align: center;\n  max-width: 400px;\n}\nbutton {\n  background: #4caf50;\n  color: white;\n  border: none;\n  padding: 10px 20px;\n  border-radius: 6px;\n  font-size: 16px;\n  cursor: pointer;\n  margin-top: 12px;\n}\nbutton:active {\n  opacity: 0.8;\n}\n<\/style>\n<\/head>\n<body>\n  <div class=\"card\">\n    <h1>🚀 Welcome to MyWebApp<\/h1>\n    <p>Edit index.html, style.css, or script.js to build your web app.<\/p>\n    <button id=\"btnClick\">Click Me!<\/button>\n    <p id=\"msg\"><\/p>\n  <\/div>\n  <script>\ndocument.getElementById('btnClick')?.addEventListener('click', function() {\n  document.getElementById('msg').innerText = '🎉 Hello from ' + document.title + '!';\n});\n<\/script>\n<\/body>\n<\/html>","project_zip_base64":"UEsDBBQACAgIANFTTV0AAAAAAAAAAAAAAAAKAAAAaW5kZXguaHRtbEVRsXICIRDt\/YqVWu9ilwJuJmNM5ySFGSclBxuPyAEDq8Yu35Emv5hPCNxprGD3Pd7bt\/Dp4\/Ny8\/aygo5620x4OcBKtxMMHSsNlLqZAPAeSYLqZExIgr1unub37AY42aNgR4On4CMxUN4Rukw8GU2d0Hg0CudDMQPjDBlp50lJi2JR3Y1CZMhisz5vsX0IgddjXRBr3B4iWsESnS2mDjF7dBHfL51KpVSmrcdxeev1eXipzRGUlSkJpmTUg1Fud4vm9+f7C7Zole8RyMPNN4MjKzQrbSiPq\/GzKpuZwb\/bDHyEpKIJVH2kItAejNVw9ocIJ2xBhlDxOlyk2gORd2C0YC25pTVqz5rhgDVOeT3iV9+B16cday4KvM5BhstoCSmqHP1qX3hjUXYwhs85ypf+AVBLBwj9ejuUMgEAAOIBAABQSwMEFAAICAgA0VNNXQAAAAAAAAAAAAAAAAkAAABzdHlsZS5jc3Ntku9ugyAUxb\/7FCT7siWlQeOWjT7NlT96NwUC2OqWvvuAtmnNJomJh+O9v